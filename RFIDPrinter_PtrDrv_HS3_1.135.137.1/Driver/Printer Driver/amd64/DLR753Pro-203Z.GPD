*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "1.128.0"
*GPDFileName: "DLR753Pro-203Z.GPD"
*ModelName: "RFID Printer DLR-753Pro-203DPI ZPL"
*MasterUnits: PAIR(40600, 40600)
*ResourceDLL: "RFIDPTRINDUI.dll"
*PrinterType: PAGE
*MaxCopies: 250

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
		*ConcealFromUI? : TRUE
    *DefaultOption: ROLLER
    *Option: ROLLER
    {
        *rcNameID: 999
    }
}

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 203)
        *TextDPI: PAIR(203, 203)
	      *MinStripBlankPixels: 32
	      EXTERN_GLOBAL: *StripBlanks: LIST(ENCLOSED,TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "" }
 		*Command: CmdEndBlockData { *Cmd : "" }
    }
    *Option: Option2
    {
        *Name: "200 x 200 " =DOTS_PER_INCH
        *DPI: PAIR(200, 200)
        *TextDPI: PAIR(200, 200)
	      *MinStripBlankPixels: 32
	      EXTERN_GLOBAL: *StripBlanks: LIST(ENCLOSED,TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "" }
 		*Command: CmdEndBlockData { *Cmd : "" }
    }

}

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: CUSTOMSIZE
    *ConflictPriority: 1

    *Option: Option1
    {
		*rcNameID: 1024
		*PageDimensions: PAIR(81200, 162400)
		*PrintableArea: PAIR(81200, 162400)
		*PrintableOrigin: PAIR(0, 0)
		*CursorOrigin: PAIR(0, 0)
        *Command: CmdSelect
      	{
          	*Order: PAGE_SETUP.1
          	*Cmd: ""
      	}

    }

 	*Option: CUSTOMSIZE
    {
        *rcNameID: =USER_DEFINED_SIZE_DISPLAY
        *MinSize: PAIR(40000, 10000)
        *MaxSize: PAIR(182200, 5237534)
        *MaxPrintableWidth: 171200 
        *MinLeftMargin: 0
		*CustCursorOriginX: %d{0}
		*CustCursorOriginY: %d{0}
		*CustPrintableOriginX: %d{0}
		*CustPrintableOriginY: %d{0}
		*CustPrintableSizeX: %d{PhysPaperWidth }
		*CustPrintableSizeY: %d{PhysPaperLength}
         
        *Command: CmdSelect
        {
          	*Order: PAGE_SETUP.1
          	*Cmd: ""
        }
    }
}

*%*Feature: Halftone
*%{
*%    *rcNameID: =HALFTONING_DISPLAY
*%    *DefaultOption: HT_PATSIZE_AUTO
*%    *Option: HT_PATSIZE_AUTO
*%    {
*%        *rcNameID: =HT_AUTO_SELECT_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_SUPERCELL_M
*%    {
*%        *rcNameID: =HT_SUPERCELL_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_6x6_M
*%    {
*%        *rcNameID: =HT_DITHER6X6_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_8x8_M
*%    {
*%        *rcNameID: =HT_DITHER8X8_DISPLAY
*%    }
*%}

*Feature: ColorMode
{
	*rcNameID: =COLOR_PRINTING_MODE_DISPLAY
	*DefaultOption: Mono
	*Option: Mono
	{
		*rcNameID: =MONO_DISPLAY
		*DevNumOfPlanes: 0
		*DevBPP: 0
		*DrvBPP: 24
		*IPCallbackID: 1
		*Color?: FALSE
	}
}


*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *Cmd: ""
}

*Command: CmdEndJob
{
	  *Order: JOB_FINISH.1
    *Cmd: ""
}

*Command: CmdStartPage
{
    *Order: PAGE_SETUP.2
    *Cmd: ""
}

*Command: CmdEndPage
{
    *Order: PAGE_FINISH.1
*%		*Cmd: "PRINT 1,1<0D0A>"
}


*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*switch: Orientation
{
    *case: PORTRAIT
    {
        *TextCaps: LIST(TC_OP_CHARACTER,TC_EA_DOUBLE,TC_IA_ABLE,TC_UA_ABLE,TC_RA_ABLE)
    }
    *case: LANDSCAPE_CC270
    {
        *TextCaps: LIST(TC_OP_CHARACTER,TC_RA_ABLE)
    }
}


*DefaultFont: 135
*DefaultCTT: 0
*switch: Orientation
{
    *case: PORTRAIT
    {
        *DeviceFonts: LIST(135,136,137,138,139,140,141,142,143,144,165,166,167,168,169,170,171,172,173,174,
+						   195,196,197,198,199,200,201,202,203,204,225,226,227,228,229,230,231,232,233,234,
+						   255,256,257,258,259,260,261,262,263,264,285,286,287,288,289,290,291,292,293,294,
+						   315,316,317,318,319,320,321,322,323,324,345,346,347,348,349,350,351,352,353,354)
    }
    *case: LANDSCAPE_CC270
    {
        *DeviceFonts: LIST(135,136,137,138,139,140,141,142,143,144,165,166,167,168,169,170,171,172,173,174,
+						   195,196,197,198,199,200,201,202,203,204,225,226,227,228,229,230,231,232,233,234,
+						   255,256,257,258,259,260,261,262,263,264,285,286,287,288,289,290,291,292,293,294,
+						   315,316,317,318,319,320,321,322,323,324,345,346,347,348,349,350,351,352,353,354)
    }
}


*%******************************************************************************************
*%                                      Cursor and Page Commands
*%******************************************************************************************
*RotateCoordinate?: TRUE
*RotateRaster?: TRUE
*RotateFont?: TRUE
*TextCaps: LIST(TC_CR_90,TC_UA_ABLE)
*MemoryUsage: LIST(FONT, RASTER, VECTOR)
*CursorXAfterCR: AT_PRINTABLE_X_ORIGIN
*BadCursorMoveInGrxMode: LIST(X_PORTRAIT,Y_LANDSCAPE)
*XMoveThreshold: 0
*YMoveThreshold: 0
*XMoveUnit: 40600
*YMoveUnit: 40600
*EjectPageWithFF?: TRUE
*OutputDataFormat: H_BYTE
*OptimizeLeftBound?: TRUE
*CursorXAfterSendBlockData: AT_GRXDATA_ORIGIN
*CursorYAfterSendBlockData: AUTO_INCREMENT

*Command: CmdCR { *Cmd : "" }
*Command: CmdLF { *Cmd : "" }
*Command: CmdFF { *Cmd : "" }